# Porta onde o servidor ira rodar
PORT=3000

# Chave secreta para assinar os tokens JWT
JWT_SECRET=change-me

# URIs de conexao com o banco de dados
MONGO_URI_AUTH=mongodb+srv://<user>:<password>@<cluster>/auth_db
MONGO_URI_USERS=mongodb+srv://<user>:<password>@<cluster>/user_db

# Opcional por enquanto (futuros modulos)
MONGO_URI_EXPENSES=mongodb+srv://<user>:<password>@<cluster>/expense_db
MONGO_URI_GROUPS=mongodb+srv://<user>:<password>@<cluster>/group_db

# Opcional para desenvolvimento
ADMIN_PASSWORD=change-me
